// AUTOGENERATED from the compute_op encode enum in idma_reg.rdl - do not edit.

/// Compute operation selector
typedef enum logic [3:0] {
    COMPUTE_NONE           = 4'd0, // No compute (plain copy).
    COMPUTE_TRANSPOSE      = 4'd1, // Tiled transpose.
    COMPUTE_MXQUANT        = 4'd2, // MX quant, FP32 source (128B -> 33B per 32-element block).
    COMPUTE_MXQUANT_FP16   = 4'd3, // MX quant, FP16 source (64B -> 33B per 32-element block).
    COMPUTE_MXDEQUANT      = 4'd4, // MX dequant, FP32 destination (33B -> 128B per 32-element block).
    COMPUTE_MXDEQUANT_FP16 = 4'd5  // MX dequant, FP16 destination (33B -> 64B per 32-element block).
} compute_op_e;
