// AUTOGENERATED from the compute_op and mx_* encode enums in idma_reg.rdl - do not edit.

/// Compute operation selector
typedef enum logic [3:0] {
    COMPUTE_NONE           = 4'd0, // No compute (plain copy).
    COMPUTE_TRANSPOSE      = 4'd1, // Tiled transpose.
    COMPUTE_MXQUANT        = 4'd2, // MX quant, FP32 source (128B -> 32B + 1B scale).
    COMPUTE_MXQUANT_FP16   = 4'd3, // MX quant, FP16 source (64B -> 32B + 1B scale).
    COMPUTE_MXDEQUANT      = 4'd4, // MX dequant, FP32 destination (32B + 1B scale -> 128B).
    COMPUTE_MXDEQUANT_FP16 = 4'd5  // MX dequant, FP16 destination (32B + 1B scale -> 64B).
} compute_op_e;

/// One bit per declared `compute_op_e` encoding
localparam logic [15:0] ComputeOpValid = 16'h003f;

/// MX option `group`
typedef enum logic [0:0] {
    MX_GROUP_G64 = 1'd0, // G = 64 blocks (one 64 B scale beat at 512 bit).
    MX_GROUP_G32 = 1'd1  // G = 32 blocks (half a 64 B scale beat).
} mx_group_e;
