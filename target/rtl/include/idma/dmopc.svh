// AUTOGENERATED from src/db/idma_dmopc.yml - do not edit.
// Included in the body of `idma_inst64_compute_pkg`, hence no include guard.

/// DMOPC opcode byte width
localparam int unsigned OpcodeWidth = 32'd8;

/// Opcode bytes; the gaps are reserved for ops not implemented in this backend family
localparam logic [OpcodeWidth-1:0] OpcPassthrough   = 8'h08;
localparam logic [OpcodeWidth-1:0] OpcMxQuant       = 8'h20;
localparam logic [OpcodeWidth-1:0] OpcMxDequant     = 8'h21;
localparam logic [OpcodeWidth-1:0] OpcMxQuantFp16   = 8'h22;
localparam logic [OpcodeWidth-1:0] OpcMxDequantFp16 = 8'h23;
localparam logic [OpcodeWidth-1:0] OpcTranspose     = 8'h50;
localparam logic [OpcodeWidth-1:0] OpcMxScaleAddr   = 8'h28;
localparam logic [OpcodeWidth-1:0] OpcMxScaleStride = 8'h29;

/// DMOPC operand layout; `rs1` is `data_arga`, `rs2` is `data_argb`
localparam int unsigned Rs1OpcByteLsb       = 32'd0;
localparam int unsigned Rs1OpcByteWidth     = 32'd8;
localparam int unsigned Rs1TpModeLsb        = 32'd16;
localparam int unsigned Rs1TpModeWidth      = 32'd2;
localparam int unsigned Rs1MxPoisonDisLsb   = 32'd18;
localparam int unsigned Rs1MxPoisonDisWidth = 32'd1;
localparam int unsigned Rs1MxRceilLsb       = 32'd19;
localparam int unsigned Rs1MxRceilWidth     = 32'd1;
localparam int unsigned Rs1MxElemFmtLsb     = 32'd20;
localparam int unsigned Rs1MxElemFmtWidth   = 32'd2;
localparam int unsigned Rs1MxGroupLsb       = 32'd22;
localparam int unsigned Rs1MxGroupWidth     = 32'd1;
localparam int unsigned Rs1MxSaddrLoLsb     = 32'd8;
localparam int unsigned Rs1MxSaddrLoWidth   = 32'd24;
localparam int unsigned Rs2MxSaddrHiLsb     = 32'd0;
localparam int unsigned Rs2MxSaddrHiWidth   = 32'd32;
localparam int unsigned Rs2MxSstrideLsb     = 32'd0;
localparam int unsigned Rs2MxSstrideWidth   = 32'd32;
localparam int unsigned Rs2TpTensorMLsb     = 32'd0;
localparam int unsigned Rs2TpTensorMWidth   = 32'd12;
localparam int unsigned Rs2TpTensorNLsb     = 32'd12;
localparam int unsigned Rs2TpTensorNWidth   = 32'd12;

/// The RTL types the layout is cut for; a widened type needs the database widened with it
localparam bit LayoutWidthsDeclared =
    (Rs1OpcByteWidth == OpcodeWidth) &&
    (Rs1TpModeWidth == TpModeWidth) &&
    (Rs1MxElemFmtWidth == $bits(idma_pkg::mx_elem_e)) &&
    (Rs1MxGroupWidth == $bits(idma_pkg::mx_group_e)) &&
    (Rs2TpTensorMWidth == idma_pkg::TransposeDimWidth) &&
    (Rs2TpTensorNWidth == idma_pkg::TransposeDimWidth);

/// An RV32 core sign-extends the operands into their upper half; no field may cross it
localparam bit LayoutRv32Safe =
    (Rs1OpcByteLsb + Rs1OpcByteWidth <= 32'd32) &&
    (Rs1TpModeLsb + Rs1TpModeWidth <= 32'd32) &&
    (Rs1MxPoisonDisLsb + Rs1MxPoisonDisWidth <= 32'd32) &&
    (Rs1MxRceilLsb + Rs1MxRceilWidth <= 32'd32) &&
    (Rs1MxElemFmtLsb + Rs1MxElemFmtWidth <= 32'd32) &&
    (Rs1MxGroupLsb + Rs1MxGroupWidth <= 32'd32) &&
    (Rs1MxSaddrLoLsb + Rs1MxSaddrLoWidth <= 32'd32) &&
    (Rs2MxSaddrHiLsb + Rs2MxSaddrHiWidth <= 32'd32) &&
    (Rs2MxSstrideLsb + Rs2MxSstrideWidth <= 32'd32) &&
    (Rs2TpTensorMLsb + Rs2TpTensorMWidth <= 32'd32) &&
    (Rs2TpTensorNLsb + Rs2TpTensorNWidth <= 32'd32);

/// Fields one opcode reads must not overlap
localparam bit LayoutDisjoint =
    (Rs1OpcByteLsb + Rs1OpcByteWidth <= Rs1MxPoisonDisLsb) &&
    (Rs1MxPoisonDisLsb + Rs1MxPoisonDisWidth <= Rs1MxRceilLsb) &&
    (Rs1MxRceilLsb + Rs1MxRceilWidth <= Rs1MxElemFmtLsb) &&
    (Rs1MxElemFmtLsb + Rs1MxElemFmtWidth <= Rs1MxGroupLsb) &&
    (Rs1OpcByteLsb + Rs1OpcByteWidth <= Rs1MxElemFmtLsb) &&
    (Rs1OpcByteLsb + Rs1OpcByteWidth <= Rs1TpModeLsb) &&
    (Rs2TpTensorMLsb + Rs2TpTensorMWidth <= Rs2TpTensorNLsb) &&
    (Rs1OpcByteLsb + Rs1OpcByteWidth <= Rs1MxSaddrLoLsb);

/// Decode the DMOPC operands; an unknown byte decodes to a plain copy and is asserted on.
function automatic idma_pkg::compute_options_t opc_decode(logic [63:0] arga, logic [63:0] argb);
    idma_pkg::compute_options_t cmp;
    logic [OpcodeWidth-1:0]     opc;
    cmp = '0;
    opc = arga[Rs1OpcByteLsb +: Rs1OpcByteWidth];
    unique case (opc)
        OpcMxQuant: begin
            cmp.enable = 1'b1;
            cmp.op     = idma_pkg::COMPUTE_MXQUANT;
            cmp.params.mx.poison_dis = arga[Rs1MxPoisonDisLsb +: Rs1MxPoisonDisWidth];
            cmp.params.mx.rceil = arga[Rs1MxRceilLsb +: Rs1MxRceilWidth];
            cmp.params.mx.elem_fmt =
                idma_pkg::mx_elem_e'(arga[Rs1MxElemFmtLsb +: Rs1MxElemFmtWidth]);
            cmp.params.mx.group = arga[Rs1MxGroupLsb +: Rs1MxGroupWidth];
        end
        OpcMxDequant: begin
            cmp.enable = 1'b1;
            cmp.op     = idma_pkg::COMPUTE_MXDEQUANT;
            cmp.params.mx.elem_fmt =
                idma_pkg::mx_elem_e'(arga[Rs1MxElemFmtLsb +: Rs1MxElemFmtWidth]);
            cmp.params.mx.group = arga[Rs1MxGroupLsb +: Rs1MxGroupWidth];
        end
        OpcMxQuantFp16: begin
            cmp.enable = 1'b1;
            cmp.op     = idma_pkg::COMPUTE_MXQUANT_FP16;
            cmp.params.mx.poison_dis = arga[Rs1MxPoisonDisLsb +: Rs1MxPoisonDisWidth];
            cmp.params.mx.rceil = arga[Rs1MxRceilLsb +: Rs1MxRceilWidth];
            cmp.params.mx.elem_fmt =
                idma_pkg::mx_elem_e'(arga[Rs1MxElemFmtLsb +: Rs1MxElemFmtWidth]);
            cmp.params.mx.group = arga[Rs1MxGroupLsb +: Rs1MxGroupWidth];
        end
        OpcMxDequantFp16: begin
            cmp.enable = 1'b1;
            cmp.op     = idma_pkg::COMPUTE_MXDEQUANT_FP16;
            cmp.params.mx.elem_fmt =
                idma_pkg::mx_elem_e'(arga[Rs1MxElemFmtLsb +: Rs1MxElemFmtWidth]);
            cmp.params.mx.group = arga[Rs1MxGroupLsb +: Rs1MxGroupWidth];
        end
        OpcTranspose: begin
            cmp.enable = 1'b1;
            cmp.op     = idma_pkg::COMPUTE_TRANSPOSE;
            cmp.params.transpose.mode = arga[Rs1TpModeLsb +: Rs1TpModeWidth];
            cmp.params.transpose.tensor_m = argb[Rs2TpTensorMLsb +: Rs2TpTensorMWidth];
            cmp.params.transpose.tensor_n = argb[Rs2TpTensorNLsb +: Rs2TpTensorNWidth];
        end
        default: cmp = '0;
    endcase
    return cmp;
endfunction

/// Does the opcode byte load a frontend register instead of the compute config?
function automatic logic opc_is_setter(logic [OpcodeWidth-1:0] opc);
    return (opc == OpcMxScaleAddr) | (opc == OpcMxScaleStride);
endfunction

/// `OpcMxScaleAddr` carries its value in units of `1 << MxScaleAddrUnitLog2` bytes
localparam int unsigned MxScaleAddrUnitLog2 = 32'd6;
function automatic logic [63:0] opc_mx_scale_addr(logic [63:0] arga, logic [63:0] argb);
    return 64'({argb[Rs2MxSaddrHiLsb +: Rs2MxSaddrHiWidth],
            arga[Rs1MxSaddrLoLsb +: Rs1MxSaddrLoWidth]}) << MxScaleAddrUnitLog2;
endfunction

/// `OpcMxScaleStride` carries its value in units of `1 << MxScaleStrideUnitLog2` bytes
localparam int unsigned MxScaleStrideUnitLog2 = 32'd6;
function automatic logic [63:0] opc_mx_scale_stride(logic [63:0] arga, logic [63:0] argb);
    return 64'($signed({argb[Rs2MxSstrideLsb +: Rs2MxSstrideWidth]})) << MxScaleStrideUnitLog2;
endfunction

/// Is the opcode byte decodable on this implementation?
function automatic logic opc_known(logic [OpcodeWidth-1:0] opc);
    idma_pkg::compute_options_t cmp;
    cmp = opc_decode(64'(opc), 64'b0);
    return (opc == OpcPassthrough) | opc_is_setter(opc) | cmp.enable;
endfunction

/// `idma_pkg::compute_op_e` encoding space; a value of it is also the all-mapped sentinel
localparam int unsigned NumComputeOpValues = 1 << $bits(idma_pkg::compute_op_e);
localparam int unsigned NumOpcodes         = 1 << OpcodeWidth;

/// Lowest `idma_pkg::compute_op_e` value that `opc_decode` reaches for no opcode byte
function automatic int unsigned first_unmapped_op();
    logic [NumComputeOpValues-1:0] reached;
    idma_pkg::compute_options_t    cmp;
    reached = '0;
    for (int unsigned b = 0; b < NumOpcodes; b++) begin
        cmp = opc_decode(64'(b), 64'b0);
        reached[cmp.op] = 1'b1;
    end
    for (int unsigned v = 0; v < NumComputeOpValues; v++) begin
        if (idma_pkg::ComputeOpValid[v] & ~reached[v]) return v;
    end
    return NumComputeOpValues;
endfunction

localparam int unsigned UnmappedComputeOp = first_unmapped_op();
localparam bit          ComputeOpsMapped  = UnmappedComputeOp == NumComputeOpValues;

