// AUTOGENERATED from the compute encode enums in idma_reg.rdl - do not edit.

<%
    exported = [("compute_op", "COMPUTE_", "Compute operation selector"),
                ("alu_func", "ALU_", "Byte-wise ALU function")]
%>\
% for rdl_name, prefix, title in exported:
<%
    enum = next(e for e in enums if e["name"] == rdl_name)
    width = enum["width"]
    name_w = max(len(m["name"]) for m in enum["choices"]) + len(prefix)
%>\
/// ${title}
typedef enum logic [${width - 1}:0] {
% for m in enum["choices"]:
    ${(prefix + m["name"]).ljust(name_w)} = ${width}'d${m["value"]}${"," if not loop.last else " "} // ${m["desc"]}
% endfor
} ${rdl_name}_e;
% if not loop.last:

% endif
% endfor
